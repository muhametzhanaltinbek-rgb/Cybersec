export default function Stars({ value, max = 10 }) {
  const pct = (value / max) * 100
  return (
    <div className="relative inline-block text-lg leading-none">
      <div className="text-line">{'★'.repeat(5)}</div>
      <div className="absolute inset-0 overflow-hidden text-accent" style={{ width: pct + '%' }}>{'★'.repeat(5)}</div>
    </div>
  )
}
